{
  "name": "desktop-pet-server",
  "version": "6.0.0",
  "description": "Activity log server and dashboard for Desktop Pet (requirement-v6.md)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "node scripts/build.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env dist/cli.js migrate",
    "key:create": "node --env-file-if-exists=.env dist/cli.js key:create",
    "key:list": "node --env-file-if-exists=.env dist/cli.js key:list",
    "key:revoke": "node --env-file-if-exists=.env dist/cli.js key:revoke",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "user:create": "node --env-file-if-exists=.env dist/cli.js user:create",
    "user:password": "node --env-file-if-exists=.env dist/cli.js user:password",
    "user:list": "node --env-file-if-exists=.env dist/cli.js user:list",
    "user:delete": "node --env-file-if-exists=.env dist/cli.js user:delete",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
