# Copy to .env (never commit .env). Values here are examples.

# MySQL or MariaDB database for the server.
DATABASE_URL=mysql://desktop_pet:change-me@127.0.0.1:3306/desktop_pet

# Separate database for `npm test` (it is emptied by the tests). Leave empty on the VPS.
TEST_DATABASE_URL=mysql://desktop_pet:change-me@127.0.0.1:3306/desktop_pet_test

# Where the server listens. Behind nginx keep 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Requests per minute per API key (NFR-35).
RATE_LIMIT_PER_MINUTE=120

# Dates in the dashboard are counted in this time zone (FR-98).
TIME_ZONE=Asia/Bangkok

# How long a dashboard login lasts, in days.
SESSION_DAYS=30

# Keep true on the VPS (https). Set false only to try the dashboard over plain http on this PC.
COOKIE_SECURE=true
